<h2 id="modal-title" hx-swap-oob="innerHTML">
  Open Source Software Licenses
</h2>
<div class="p-4">
  <p>This software includes a variety of open source software packages, which are listed below:</p>
  <% data.items.map(item=> { %>
    <h3><%- item.name %></h3>
    <table class="table w-100">
      <tbody>
        <tr>
          <th>Version</th>
          <td><%- item.version %></td>
        </tr>
        <% if (typeof item.author==="string" ) { %>
          <tr>
            <th>Author</th>
            <td><%- item.author %></td>
          </tr>
          <% } else if (typeof item.author==="object" ) { %>
            <tr>
              <th>Author</th>
              <td><%- item.author.name %></td>
            </tr>
            <tr>
              <th>URL</th>
              <td class="text-break"><%- item.author.url %></td>
            </tr>
            <% } %>
              <% if (typeof item.repository) { %>
                <tr>
                  <th>Repository</th>
                  <td><a href="<%- item.repository %>" target="_blank"><%- item.repository %></a></td>
                </tr>
                <% } %>
                  <% if (typeof item.source) { %>
                    <tr>
                      <th>Source</th>
                      <td class="text-break"><a href="<%- item.source %>" target="_blank"><%- item.source %></a></td>
                    </tr>
                    <% } %>
                      <tr>
                        <th>License</th>
                        <td><%- item.license %></td>
                      </tr>
      </tbody>
    </table>
    <% if (item.licenseText) { %>
      <details class="mt-2">
        <summary>License details</summary>
        <%= item.licenseText.replace(/(\\r?\\n)/g, "<br>" ) %>
      </details>
      <% } %>
        <hr>
        <% }) %>
</div>