<ul class="ps-2">
  <% data.references.forEach(reference=> { %>
    <li><%- reference %></li>
    <% }); %>
</ul>
<button type="button" class="btn btn-sm" onclick="copyListToClipboard(this.previousElementSibling)"
  title="Copy to clipboard">
  <svg width="16" height="16" fill="currentColor" class="me-1">
    <use xlink:href="/static/bootstrap-icons/bootstrap-icons.svg#copy" />
  </svg>
  Copy to clipboard
</button>